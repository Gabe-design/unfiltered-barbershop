# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/unfiltered_barbershop"

# ─────────────────────────────────────────────
# NEXT AUTH
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-nextauth-key-min-32-chars"

# ─────────────────────────────────────────────
# SITE URL
# ─────────────────────────────────────────────
# Public origin used for canonical/OG URLs, the sitemap, JSON-LD, and links in
# emails. Leave empty on Vercel to use the project's production URL automatically;
# set it once a custom domain is live (e.g. https://unfilteredbarbershop.com).
NEXT_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────
# EMAIL — RESEND (https://resend.com)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key_here"
# Must be an address on a domain verified in Resend, or customer emails will not
# be delivered (the onboarding@resend.dev fallback only sends to your own inbox).
RESEND_FROM_EMAIL="Unfiltered Barbershop <bookings@yourdomain.com>"
ADMIN_EMAIL="admin@unfilteredbarbershop.com"

# ─────────────────────────────────────────────
# SMS — TWILIO (optional)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─────────────────────────────────────────────
# CRON SECURITY (Vercel Cron Jobs)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ─────────────────────────────────────────────
# GOOGLE MAPS (public)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─────────────────────────────────────────────
# ANALYTICS (public — optional)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────
# SEO
# ─────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=""
