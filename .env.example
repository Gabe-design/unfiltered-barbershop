# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/unfiltered_barbershop"

# ─────────────────────────────────────────────
# NEXT AUTH
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-nextauth-key-min-32-chars"

# ─────────────────────────────────────────────
# EMAIL — RESEND (https://resend.com)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key_here"
ADMIN_EMAIL="admin@unfilteredbarbershop.com"

# ─────────────────────────────────────────────
# SMS — TWILIO (optional)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─────────────────────────────────────────────
# CRON SECURITY (Vercel Cron Jobs)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ─────────────────────────────────────────────
# GOOGLE MAPS (public)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─────────────────────────────────────────────
# ANALYTICS (public — optional)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────
# SEO
# ─────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=""
